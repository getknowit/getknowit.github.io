---
import InstallButton from './InstallButton.astro';
import { site } from '../site.config';
const home = Astro.url.pathname === '/' || Astro.url.pathname === '/index.html';
const at = (hash: string) => (home ? hash : `/${hash}`);
---
<header class="site-header">
  <div class="container nav">
    <a class="brand" href="/" aria-label={`${site.name} home`}><img src="/icon.png" alt="" width="30" height="30" />{site.name}</a>
    <nav class="nav-links" aria-label="Main">
      <a href={at('#titles')}>Titles, answered</a>
      <a href={at('#how')}>How it works</a>
      <a href={at('#faq')}>FAQ</a>
      <a href="/changelog">Changelog</a>
    </nav>
    <div class="nav-end">
      <a class="sponsor" href={site.links.sponsor} aria-label="Sponsor Know It on GitHub">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 21s-7.6-4.7-9.8-8.6C.4 9 2.2 5 6 5c2.2 0 3.6 1.2 4.5 2.4C11.4 6.2 12.8 5 15 5c3.8 0 5.6 4 3.8 7.4C16.6 16.3 12 21 12 21z"/></svg><span>Sponsor</span>
      </a>
      <a class="icon-btn" href={site.links.github} aria-label="Know It on GitHub">
        <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
      </a>
      <button class="icon-btn" type="button" data-theme-toggle aria-label="Switch light or dark">
        <svg class="theme-light-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        <svg class="theme-dark-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
      <InstallButton small />
      <details class="menu">
        <summary class="icon-btn" aria-label="Menu">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        </summary>
        <div class="menu-panel">
          <a href={at('#titles')}>Titles, answered</a>
          <a href={at('#how')}>How it works</a>
          <a href={at('#install')}>Install</a>
          <a href={at('#faq')}>FAQ</a>
          <a href="/changelog">Changelog</a>
          <a href="/support">Support</a>
        </div>
      </details>
    </div>
  </div>
</header>
